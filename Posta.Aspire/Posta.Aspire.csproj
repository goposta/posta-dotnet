<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Posta.Aspire</PackageId>
    <AssemblyName>Posta.Aspire</AssemblyName>
    <RootNamespace>Posta.Aspire</RootNamespace>
    <Version>0.1.14</Version>
    <Title>Posta Aspire Client Integration</Title>
    <Description>Aspire integration for Posta .NET SDK 0.1.14 and the Posta 0.14.0 API.</Description>
    <Authors>Posta</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.goposta.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/goposta/posta-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>posta aspire email sdk api client</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PostaApiVersion" Value="0.14.0" />
    <ProjectReference Include="..\Posta.csproj" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
