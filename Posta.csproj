<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Posta</PackageId>
    <AssemblyName>Posta</AssemblyName>
    <RootNamespace>Posta</RootNamespace>
    <Version>0.1.14</Version>
    <Title>Posta .NET SDK</Title>
    <Description>.NET SDK 0.1.14 for the Posta 0.14.0 API.</Description>
    <Authors>Posta</Authors>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://docs.goposta.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/goposta/posta-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>posta email sdk api client</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PostaApiVersion" Value="0.14.0" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Remove="Posta.Aspire\**\*.cs" />
    <Compile Remove="Posta.Tests\**\*.cs" />
    <None Remove="Posta.Aspire\**\*" />
    <None Remove="Posta.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Posta.Tests" />
    <InternalsVisibleTo Include="Posta.Aspire" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

</Project>
